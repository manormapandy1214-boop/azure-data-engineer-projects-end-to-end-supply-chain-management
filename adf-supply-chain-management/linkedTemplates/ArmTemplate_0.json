{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-supply-chain-management"
		},
		"LS_PostgreSql1_source_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_PostgreSql1_source'"
		},
		"LS_seondsource_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_seondsource'"
		},
		"LS_PostgreSql1_source_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-cool-mountain-arq2z75z-pooler.c-4.us-west-2.aws.neon.tech"
		},
		"LS_PostgreSql1_source_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_PostgreSql1_source_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"LS_supplychain_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://supplychainproject.dfs.core.windows.net/"
		},
		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://supply-chain-keyvault1.vault.azure.net/"
		},
		"LS_seondsource_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "DESKTOP-RI7M8G0\\SQLEXPRESS"
		},
		"LS_seondsource_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "master"
		},
		"LS_seondsource_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/LS_PostgreSql1_source')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "PostgreSqlV2",
				"typeProperties": {
					"server": "[parameters('LS_PostgreSql1_source_properties_typeProperties_server')]",
					"port": 5432,
					"database": "[parameters('LS_PostgreSql1_source_properties_typeProperties_database')]",
					"username": "[parameters('LS_PostgreSql1_source_properties_typeProperties_username')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('LS_PostgreSql1_source_password')]"
					},
					"sslMode": 2,
					"authenticationType": "Basic"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_supplychain')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('LS_supplychain_properties_typeProperties_url')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/integrationRuntime1-selfhosted')]",
			"type": "Microsoft.DataFactory/factories/integrationRuntimes",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "SelfHosted",
				"typeProperties": {}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/AzureKeyVault1')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureKeyVault",
				"typeProperties": {
					"baseUrl": "[parameters('AzureKeyVault1_properties_typeProperties_baseUrl')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_seondsource')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "SqlServer",
				"typeProperties": {
					"server": "[parameters('LS_seondsource_properties_typeProperties_server')]",
					"database": "[parameters('LS_seondsource_properties_typeProperties_database')]",
					"encrypt": "optional",
					"trustServerCertificate": true,
					"authenticationType": "SQL",
					"userName": "[parameters('LS_seondsource_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('LS_seondsource_password')]"
					}
				},
				"connectVia": {
					"referenceName": "integrationRuntime1-selfhosted",
					"type": "IntegrationRuntimeReference"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/integrationRuntimes/integrationRuntime1-selfhosted')]"
			]
		}
	]
}