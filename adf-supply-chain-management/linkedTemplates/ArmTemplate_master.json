{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-supply-chain-management"
		},
		"LS_PostgreSql1_source_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_PostgreSql1_source'"
		},
		"LS_seondsource_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_seondsource'"
		},
		"LS_PostgreSql1_source_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-cool-mountain-arq2z75z-pooler.c-4.us-west-2.aws.neon.tech"
		},
		"LS_PostgreSql1_source_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_PostgreSql1_source_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"LS_seondsource_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "DESKTOP-RI7M8G0\\SQLEXPRESS"
		},
		"LS_seondsource_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "master"
		},
		"LS_seondsource_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		},
		"LS_supplychain_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://supplychainproject.dfs.core.windows.net/"
		},
		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://supply-chain-keyvault1.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-supply-chain-management_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_PostgreSql1_source_password": {
						"value": "[parameters('LS_PostgreSql1_source_password')]"
					},
					"LS_seondsource_password": {
						"value": "[parameters('LS_seondsource_password')]"
					},
					"LS_PostgreSql1_source_properties_typeProperties_server": {
						"value": "[parameters('LS_PostgreSql1_source_properties_typeProperties_server')]"
					},
					"LS_PostgreSql1_source_properties_typeProperties_database": {
						"value": "[parameters('LS_PostgreSql1_source_properties_typeProperties_database')]"
					},
					"LS_PostgreSql1_source_properties_typeProperties_username": {
						"value": "[parameters('LS_PostgreSql1_source_properties_typeProperties_username')]"
					},
					"LS_supplychain_properties_typeProperties_url": {
						"value": "[parameters('LS_supplychain_properties_typeProperties_url')]"
					},
					"AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault1_properties_typeProperties_baseUrl')]"
					},
					"LS_seondsource_properties_typeProperties_server": {
						"value": "[parameters('LS_seondsource_properties_typeProperties_server')]"
					},
					"LS_seondsource_properties_typeProperties_database": {
						"value": "[parameters('LS_seondsource_properties_typeProperties_database')]"
					},
					"LS_seondsource_properties_typeProperties_userName": {
						"value": "[parameters('LS_seondsource_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}